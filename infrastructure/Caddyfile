treestock.com.au {
    handle /api/subscribe {
        uri strip_prefix /api
        reverse_proxy localhost:8099
    }
    handle /api/confirm {
        uri strip_prefix /api
        reverse_proxy localhost:8099
    }
    handle /api/preferences {
        uri strip_prefix /api
        reverse_proxy localhost:8099
    }
    handle /api/unsubscribe {
        uri strip_prefix /api
        reverse_proxy localhost:8099
    }
    handle /api/watch-variety {
        uri strip_prefix /api
        reverse_proxy localhost:8099
    }
    handle /api/unwatch-variety {
        uri strip_prefix /api
        reverse_proxy localhost:8099
    }
    handle /api/wishlist {
        uri strip_prefix /api
        reverse_proxy localhost:8099
    }
    handle /api/wishlist-counts {
        uri strip_prefix /api
        reverse_proxy localhost:8099
    }
    handle /api/request-manage-link {
        uri strip_prefix /api
        reverse_proxy localhost:8099
    }

    # Resend `email.received` webhook for the nursery contact log (DAL-273).
    # Deliberately NOT behind Cloudflare Access: Resend has to reach it
    # unauthenticated. It is protected instead by the Svix HMAC signature, which
    # subscribe_server verifies against the whole raw body before parsing it.
    handle /api/resend-inbound {
        uri strip_prefix /api
        reverse_proxy localhost:8099
    }

    # Read-only subscriber admin view. Gate with Cloudflare Access (Zero Trust)
    # at the edge; subscribe_server.py also validates the CF Access JWT so a
    # direct-to-origin request can't bypass it.
    handle /admin {
        reverse_proxy localhost:8099
    }
    handle /admin/ {
        reverse_proxy localhost:8099
    }

    # /admin/digest[/<YYYY-MM-DD>]: the archived daily digests. Wildcarded so a
    # new admin subpage doesn't need a Caddy edit. The Cloudflare Access app
    # covers /admin and every subpath (verified 2026-08-10) and
    # subscribe_server fails closed without a valid JWT, so an unrouted path
    # under here is a backend 404, not an exposure.
    handle /admin/* {
        reverse_proxy localhost:8099
    }

    # Bare /unsubscribe is referenced by older welcome emails; route it to the
    # backend (handles GET /unsubscribe) so those links don't 404. New emails use
    # the /unsubscribe.html static page.
    handle /unsubscribe {
        reverse_proxy localhost:8099
    }

    root * /opt/dale/dashboard
    encode zstd gzip
    file_server

    handle_errors {
        @404 expression {err.status_code} == 404
        rewrite @404 /404.html
        file_server
    }

    # Versioned static assets (?v=YYYYMMDD cache-busted) can cache forever.
    @versioned path /styles.css /dashboard.js /data.js
    header @versioned Cache-Control "public, max-age=31536000, immutable"
    # Everything else (HTML) stays short-lived so daily rebuilds show up.
    @unversioned not path /styles.css /dashboard.js /data.js
    header @unversioned Cache-Control "public, max-age=3600"

    # DAL-294: access log. Plausible is a client-side tag, so every crawler,
    # every curl and every fetch of /shipping-reachability.json (not an HTML
    # page, so it cannot run JavaScript at all) has always been invisible.
    #
    # What is deliberately NOT logged:
    #   - the query string. /manage.html and /unsubscribe.html carry an HMAC
    #     token and the subscriber's email in it. The regexp drops everything
    #     from the first ? onwards, so a token can never reach disk.
    #   - the client IP, in all four places it arrives. remote_ip is
    #     Cloudflare's anyway; the real one is in Cf-Connecting-Ip,
    #     X-Forwarded-For, True-Client-Ip or Forwarded. None of the questions
    #     this log exists to answer need an IP.
    #   Header names must be in Go's canonical casing (Cf-Connecting-Ip, not
    #   Cf-Connecting-IP) or the delete silently does nothing.
    #
    # mode 0644 so the nightly summary can read it as the dale user. Rolled by
    # Caddy itself, so there is no cron cleanup to forget.
    log {
        output file /var/log/caddy/treestock-access.log {
            mode 0644
            roll_size 10MiB
            roll_keep 10
            roll_keep_for 336h
        }
        format filter {
            wrap json
            fields {
                request>remote_ip delete
                request>remote_port delete
                request>client_ip delete
                request>tls delete
                request>headers>Cookie delete
                request>headers>Authorization delete
                request>headers>Cf-Connecting-Ip delete
                request>headers>X-Forwarded-For delete
                request>headers>True-Client-Ip delete
                request>headers>Forwarded delete
                resp_headers delete
                request>uri regexp "\?.*$" ""
            }
        }
    }
}

beestock.com.au, www.beestock.com.au {
    # beestock discontinued 2026-07-23 (DEC-229). Scrapers, alerts, and the
    # subscribe server are retired; pages stay up static. Subscribe endpoints
    # return 410 instead of proxying to the stopped service on :8098.
    handle /api/subscribe {
        respond "beestock is no longer updated and subscriptions are closed." 410
    }
    handle /api/unsubscribe {
        respond "beestock subscriptions are closed. All subscribers have been removed." 410
    }
    handle /unsubscribe {
        respond "beestock subscriptions are closed. All subscribers have been removed." 410
    }

    root * /opt/dale/bee-dashboard
    encode zstd gzip
    file_server

    header {
        Cache-Control "public, max-age=3600"
    }
}

stock.scion.exchange, leafscan.com.au, www.leafscan.com.au,
www.treestock.com.au {
    redir https://treestock.com.au{uri} permanent
}

