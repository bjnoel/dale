<div class="bg-amber-50 border border-amber-200 rounded-lg px-4 py-3 mb-6 text-sm text-amber-900">
    <p>No nursery we track is currently listing {{ name }}.</p>
{% if last_stock %}
    <p class="mt-1">{{ last_stock }}</p>
{% endif %}
{% if tracking %}
    <p class="mt-1">{{ tracking }}</p>
{% endif %}
{% if cta_html %}
    <div class="mt-3">{{ cta_html|safe }}</div>
{% endif %}
  </div>
