{{ head|safe }}
{{ header|safe }}

<main class="{{ content_max_width }} mx-auto px-4 py-10">
  {# The visible link is load-bearing: a stub returns 200, so anyone with meta
     refresh disabled sees only what is on this page. No watch form here, ever:
     a watch on a slug that is no longer generated can never fire. #}
  <h1 class="text-2xl font-bold text-green-900 mb-2">{{ heading }}</h1>
  <p class="text-gray-600 mb-6">
    {{ lede }}
  </p>
  <p>
    <a href="{{ target_href }}"
       class="inline-block px-4 py-2 bg-green-700 text-white rounded-lg hover:bg-green-800 font-medium">
      Go to {{ target_title }}
    </a>
  </p>
</main>

{{ footer|safe }}

</body>
</html>
