{% if min_price %}      <div class="hero-stat"><strong>{{ min_price }}</strong>cheapest right now</div>
{% endif %}      <div class="hero-stat"><strong>{{ nursery_count }}</strong>nurseries with stock</div>
      <div class="hero-stat"><strong>Daily</strong>stock updates</div>
    </div>
