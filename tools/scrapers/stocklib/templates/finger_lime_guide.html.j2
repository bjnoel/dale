{% if digest_signup %}<script>
async function subscribe() {
  const emailInput = document.getElementById('emailInput');
  const subBtn = document.getElementById('subBtn');
  const subMsg = document.getElementById('subMsg');
  const email = emailInput.value.trim();
  if (!email || !email.includes('@')) {
    subMsg.textContent = 'Please enter a valid email address.';
    subMsg.style.color = '#dc2626';
    return;
  }
  subBtn.disabled = true;
  subBtn.textContent = 'Subscribing...';
  subMsg.textContent = '';
  try {
    const res = await fetch('https://treestock.com.au/api/subscribe', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email })
    });
    const data = await res.json();
    if (res.ok) {
      subMsg.textContent = 'Subscribed. Check your inbox for a welcome email.';
      subMsg.style.color = '#065f46';
      emailInput.value = '';
    } else {
      subMsg.textContent = data.error || 'Something went wrong. Please try again.';
      subMsg.style.color = '#dc2626';
    }
  } catch (e) {
    subMsg.textContent = 'Could not connect. Please try again.';
    subMsg.style.color = '#dc2626';
  }
  subBtn.disabled = false;
  subBtn.textContent = 'Get alerts';
}
document.getElementById('emailInput').addEventListener('keydown', function(e) {
  if (e.key === 'Enter') subscribe();
});
</script>{% endif %}

</body>
