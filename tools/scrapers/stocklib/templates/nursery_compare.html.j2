{{ head|safe }}
{{ header_html|safe }}

<main class="{{ content_max_width }} mx-auto px-4 py-6">
  {{ breadcrumb|safe }}

  <h1 class="text-2xl font-bold text-gray-900 mb-1">Compare Australian Fruit Tree Nurseries</h1>
  <p class="text-gray-500 text-sm mb-4">
    We track {{ total_nurseries }} nurseries. {{ total_in_stock_fmt }} of their {{ total_products_fmt }} products are in stock right now.
    Updated {{ today }}.
  </p>

  <div class="flex flex-wrap gap-2 mb-4">
    <button class="filter-btn active text-xs px-3 py-1.5 rounded border border-gray-300 hover:border-green-600"
            onclick="filterNurseries('all', this)">All nurseries</button>
    <button class="filter-btn text-xs px-3 py-1.5 rounded border border-gray-300 hover:border-green-600"
            onclick="filterNurseries('instock', this)">50+ in stock</button>
  </div>

  <div class="overflow-x-auto rounded-lg border border-gray-200">
    <table id="nursery-table" class="w-full text-left">
      <thead>
        <tr class="bg-gray-50 border-b border-gray-200 text-xs text-gray-500 uppercase">
          <th class="py-2 px-3">Nursery</th>
          <th class="py-2 px-3 text-center">In Stock / Total</th>
          <th class="py-2 px-3 text-center">Species</th>
          <th class="py-2 px-3">States</th>
        </tr>
      </thead>
      <tbody id="nursery-tbody">
        {{ "" }}
{% for n in row_view %}
        <tr class="{{ 'bg-white' if loop.index0 % 2 == 0 else 'bg-gray-50' }} hover:bg-green-50 border-b border-gray-100">
          <td class="py-2 px-3 text-sm">
            <a href="/nursery/{{ n.key }}.html" class="text-green-700 hover:underline font-medium">{{ n.name }}</a>
{% if n.location %}            <br><span class="text-xs text-gray-400">{{ n.location }}</span>
{% endif %}          </td>
          <td class="py-2 px-3 text-center">
            <span class="font-semibold text-green-700">{{ n.in_stock }}</span>
            <span class="text-xs text-gray-400"> / {{ n.total }}</span>
            <div class="w-full bg-gray-100 rounded-full h-1.5 mt-1"><div class="bg-green-500 h-1.5 rounded-full" style="width:{{ n.pct }}%"></div></div>
          </td>
          <td class="py-2 px-3 text-center text-sm">{{ n.species }}</td>
          <td class="py-2 px-3 text-xs text-gray-600">{{ n.ship_str }} {% if not n.local_lbl and n.restrict %}<span class="text-xs text-red-700">{{ n.restrict }}</span>{% endif %}</td>
        </tr>
{% endfor %}      </tbody>
    </table>
  </div>

  <div class="mt-6 bg-gray-50 border border-gray-200 rounded-lg p-4 text-sm text-gray-700">
    <h2 class="font-semibold mb-2">About this comparison</h2>
    <p class="mb-2">This is every nursery we track, side by side. We update it daily from each nursery's website.</p>
    <p class="mb-2"><strong>In Stock / Total:</strong> How many products are in stock right now, out of everything we track at that nursery. The bar shows it as a percentage.</p>
    <p class="mb-2"><strong>Species:</strong> How many different fruit species (mango, avocado, lychee and so on) the nursery has, however many varieties of each.</p>
    <p><strong>States:</strong> Where each nursery ships. WA, NT and TAS have strict quarantine rules, so plenty of interstate nurseries can't send plants there.</p>
  </div>

  <div class="mt-4 text-xs text-gray-400">
    See also: <a href="/compare/" class="text-green-700 hover:underline">price comparisons by species</a> |
    <a href="/nursery/" class="text-green-700 hover:underline">individual nursery profiles</a>
  </div>
</main>

<script>
function filterNurseries(filter, btn) {
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  const rows = document.querySelectorAll('#nursery-tbody tr');
  rows.forEach(row => {
    const instock = parseInt(row.querySelector('td:nth-child(2) .font-semibold')?.textContent || '0');
    if (filter === 'all') row.classList.remove('hidden-row');
    else if (filter === 'instock') row.classList.toggle('hidden-row', instock < 50);
  });
}
</script>

{{ footer|safe }}

</body>
</html>